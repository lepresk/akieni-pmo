# Copy to .env.local for development. Never commit real secrets.

# --- Database (PostgreSQL via DBngin) ---
# Match your DBngin instance (host/port/user/password). DBngin commonly exposes
# PostgreSQL on 127.0.0.1 with user "postgres" and no password; adjust as needed.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/akieni_dev
# Isolated database used by the test suite (real Postgres, not mocked).
DATABASE_URL_TEST=postgres://postgres@127.0.0.1:5432/akieni_test

# --- Auth (Google Workspace SSO only) ---
# OAuth client from the Akieni Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of allowed Workspace domains (hd claim). Logins from any
# other domain are rejected.
GOOGLE_ALLOWED_DOMAINS=akieni.com
# Secret used to sign session cookies.
AUTH_SECRET=

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
